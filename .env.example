[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# LMCC environment configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Accounts & cross-device sync ─────────────────────────────
# Required for "login from anywhere" (the same account working on
# different machines/browsers). Without these, auth still works and
# SURVIVES server restarts via a local .data/auth-kv.json store —
# but accounts are tied to one server instance.
#
# On Vercel you can skip these: creating a KV store in the dashboard
# (Storage → Create → Marketplace Redis) auto-injects
# KV_REST_API_URL / KV_REST_API_TOKEN, which this app also accepts.
#
# Free tier: https://upstash.com → create Redis DB → REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AUTH_PEPPER (REQUIRED in production) ─────────────────────
# Server-side secret that:
#   - encrypts user PII (name/email/employee ID) with AES-256-GCM
#   - HMACs email lookup keys (no plaintext email at rest)
# Generate 32+ random hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Local dev works without it (a server secret is auto-generated at
# .data/pepper.secret and reused across restarts). Deployed production
# builds on serverless REFUSE credential operations when this is unset —
# fail closed by design.
AUTH_PEPPER=

# ── OFFICER_INVITE_CODES (recommended) ───────────────────────
# Comma-separated codes that allow registering an account as
# "Compliance Officer / Admin" (review queue + full access). Validated
# SERVER-side on the register endpoint — clients cannot self-select the
# privileged role. Without this variable, officer registration is
# DISABLED and every new signup becomes a Seller (the safe default).
# Share codes only with people who should hold admin rights.
#   Example: OFFICER_INVITE_CODES=sih-officer-2026,backup-code-9x7
OFFICER_INVITE_CODES=
