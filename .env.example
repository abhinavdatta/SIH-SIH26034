[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# LMCC environment configuration
# Copy this file to .env (local) and mirror in Vercel → Settings →
# Environment Variables. Never commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── RECOMMENDED: Supabase Postgres (accounts/sessions/scans) ─
# Real relational backend — works on Vercel with no filesystem.
# 1. Run supabase/migrations/0001_lmcc_auth.sql once:
#    Supabase Dashboard → SQL Editor → paste → Run
# 2. Project Settings → API:
#      Project URL  → SUPABASE_URL
#      service_role secret → SUPABASE_SERVICE_ROLE_KEY  (SECRET — server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AUTH_PEPPER (REQUIRED in production) ─────────────────────
# Encrypts user PII (AES-256-GCM) and HMACs email lookup keys.
# Generate 32+ random hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it after accounts exist makes stored PII undecryptable —
# set it once before real users sign up.
AUTH_PEPPER=

# ── OFFICER_INVITE_CODES ─────────────────────────────────────
# Comma-separated codes required to register as Compliance Officer /
# Admin (validated server-side). Unset → officer sign-up disabled,
# every new account is a Seller.
#   Example: OFFICER_INVITE_CODES=sih-officer-2026,backup-code-9x7
OFFICER_INVITE_CODES=

# ── Alternative backends (optional) ──────────────────────────
# If Supabase vars are absent, the app falls back to, in order:
#  1) Upstash Redis:  UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#     (Vercel Marketplace KV auto-injects KV_REST_API_URL/TOKEN, also accepted)
#  2) Local file .data/auth-kv.json (self-hosted only; not on Vercel)
#  3) In-memory (dev only — resets on restart)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
