{
  "expo": {
    "name": "LMCC",
    "slug": "lmcc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "lmcc",
    "backgroundColor": "#020617",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abhinavdatta.lmcc",
      "infoPlist": {
        "NSCameraUsageDescription": "LMCC uses the camera to photograph product labels for compliance scanning.",
        "NSPhotoLibraryUsageDescription": "LMCC lets you pick an existing label photo to scan."
      }
    },
    "android": {
      "package": "com.abhinavdatta.lmcc",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sharing",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LMCC to photograph product labels for compliance scanning.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LMCC to pick an existing label photo to scan."
        }
      ]
    ]
  }
}
